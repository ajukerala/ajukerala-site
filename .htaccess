# AJU KERALA - Apache settings (ignored safely if your host does not use Apache)
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Always use https
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://ajukerala.com/$1 [R=301,L]
# Always use ajukerala.com without www
RewriteCond %{HTTP_HOST} ^www\.ajukerala\.com$ [NC]
RewriteRule ^(.*)$ https://ajukerala.com/$1 [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
